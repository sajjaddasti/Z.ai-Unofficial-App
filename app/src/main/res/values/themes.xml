<resources>
    <style name="Theme.Zai" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#07090C</item>
    </style>

    <style name="Theme.Zai.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#07090C</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">280</item>
        <item name="postSplashScreenTheme">@style/Theme.Zai</item>
    </style>
</resources>
